---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BlogCard from "../../components/BlogCard.astro";
import ContactForm from "../../components/ContactForm.astro";
import { getFeaturedPosts, urlFor } from "../../lib/sanity";
import { t, translateToZh, type SupportedLanguage } from "../../lib/translate";
import type { Post } from "../../lib/posts";

export function getStaticPaths() {
    return [{ params: { lang: "en" } }, { params: { lang: "zh" } }];
}

const { lang } = Astro.params as { lang: SupportedLanguage };

const baseTitle = "SEO Portfolio | Real Projects & Learning Journey";
const baseDescription =
    "SEO portfolio showcasing real projects, technical optimization, case studies, and continuous growth through hands-on testing and data-driven strategies.";

// Translate if Chinese
const pageTitle = lang === "zh" ? await translateToZh(baseTitle) : baseTitle;
const pageDescription =
    lang === "zh" ? await translateToZh(baseDescription) : baseDescription;

// Fetch featured posts from Sanity
const featuredPosts = await getFeaturedPosts(3);

// Translate posts if Chinese
let displayPosts = featuredPosts;
if (lang === "zh" && featuredPosts.length > 0) {
    displayPosts = await Promise.all(
        featuredPosts.map(async (post: Post) => ({
            ...post,
            title: await translateToZh(post.title),
            excerpt: await translateToZh(post.excerpt),
        })),
    );
}

const services = [
    {
        icon: "📊",
        titleEn: "Technical SEO Audits",
        titleZh: "技术SEO审计",
        descEn: "Comprehensive analysis of your website's technical health, identifying and fixing issues that impact rankings.",
        descZh: "全面分析您网站的技术健康状况，识别并修复影响排名的问题。",
    },
    {
        icon: "📝",
        titleEn: "Content Strategy",
        titleZh: "内容策略",
        descEn: "Data-driven content planning that aligns with search intent and drives qualified organic traffic.",
        descZh: "数据驱动的内容规划，与搜索意图保持一致，带来高质量的自然流量。",
    },
    {
        icon: "🔗",
        titleEn: "Link Building",
        titleZh: "链接建设",
        descEn: "Ethical, white-hat link acquisition strategies that build domain authority and trust.",
        descZh: "道德的白帽链接获取策略，建立域名权威和信任。",
    },
    {
        icon: "📈",
        titleEn: "Analytics & Reporting",
        titleZh: "分析与报告",
        descEn: "Clear, actionable insights with custom dashboards tracking the metrics that matter.",
        descZh: "清晰可执行的洞察，自定义仪表板跟踪重要指标。",
    },
];
---

<BaseLayout title={pageTitle} description={pageDescription} lang={lang}>
    <Header lang={lang} />

    <main>
        <!-- Hero Section -->
        <section class="min-h-[80vh] flex items-center py-20 md:py-32">
            <div class="container">
                <div class="max-w-3xl mb-16">
                    <span
                        class="inline-block px-4 py-2 text-sm font-bold tracking-wide text-primary bg-primary/10 border border-primary/20 rounded-full mb-6 animate-fade-in-up"
                        >{
                            lang === "zh"
                                ? "SEO策略师 & 顾问"
                                : "SEO Strategist & Consultant"
                        }</span
                    >
                    <h1
                        class="text-5xl md:text-7xl lg:text-8xl font-bold leading-tight mb-8 animate-fade-in-up delay-100"
                    >
                        {t("heroTitle", lang)}
                        <span class="text-gradient relative inline-block"
                            >{t("heroTitleAccent", lang)}
                            <div
                                class="absolute inset-0 bg-primary/20 blur-2xl -z-10 animate-pulse-slow"
                            >
                            </div>
                        </span>
                        {t("heroTitleEnd", lang)}
                    </h1>
                    <p
                        class="mt-8 text-lg md:text-xl text-text-muted leading-relaxed max-w-2xl animate-fade-in-up delay-200"
                    >
                        {t("heroDescription", lang)}
                    </p>
                    <div
                        class="flex flex-wrap gap-4 mt-10 animate-fade-in-up delay-300"
                    >
                        <a href={`/${lang}/blog`} class="btn btn-primary"
                            >{t("readInsights", lang)}</a
                        >
                        <a href={`/${lang}/about`} class="btn btn-ghost"
                            >{t("learnAboutMe", lang)}</a
                        >
                    </div>
                </div>

                <div
                    class="flex flex-col md:flex-row gap-8 md:gap-16 pt-10 border-t border-white/10 mt-12 animate-fade-in-up delay-300"
                >
                    <div
                        class="flex flex-row md:flex-col items-center md:items-start gap-4 md:gap-1"
                    >
                        <span
                            class="font-heading text-4xl md:text-5xl font-bold text-text relative"
                            >5+
                            <span
                                class="absolute -top-2 -right-2 w-2 h-2 bg-primary rounded-full animate-pulse"
                            ></span>
                        </span>
                        <span
                            class="text-sm text-text-muted uppercase tracking-wider font-medium"
                            >{t("projectsCompleted", lang)}</span
                        >
                    </div>
                    <div
                        class="flex flex-row md:flex-col items-center md:items-start gap-4 md:gap-1"
                    >
                        <span
                            class="font-heading text-4xl md:text-5xl font-bold text-text"
                            >2K+</span
                        >
                        <span
                            class="text-sm text-text-muted uppercase tracking-wider font-medium"
                            >{t("organicVisits", lang)}</span
                        >
                    </div>
                    <div
                        class="flex flex-row md:flex-col items-center md:items-start gap-4 md:gap-1"
                    >
                        <span
                            class="font-heading text-4xl md:text-5xl font-bold text-text"
                            >1+</span
                        >
                        <span
                            class="text-sm text-text-muted uppercase tracking-wider font-medium"
                            >{t("yearsLearning", lang)}</span
                        >
                    </div>
                </div>

                <div class="mt-8">
                    <p
                        class="text-lg text-text-muted leading-relaxed max-w-2xl"
                    >
                        {
                            lang === "zh"
                                ? "这些成果建立在持续学习、真实项目和不断优化的基础上，以数据驱动分析、实践实验和持续的绩效跟踪为指导，并且随着时间的推移稳步提升。"
                                : "These results are built through continuous learning, real projects, and ongoing optimization, guided by data-driven analysis, hands-on experimentation, and consistent performance tracking and they are steadily improving over time."
                        }
                    </p>
                </div>
            </div>
        </section>

        <!-- Services Section -->
        <section class="py-20">
            <div class="container">
                <div class="text-center max-w-2xl mx-auto mb-16">
                    <h2 class="text-4xl md:text-5xl font-bold mb-4">
                        {t("whatIDo", lang)}
                    </h2>
                    <p class="text-text-muted text-lg">
                        {t("servicesDesc", lang)}
                    </p>
                </div>

                <div
                    class="grid grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-6"
                >
                    {
                        services.map((service) => (
                            <div class="card flex flex-col items-start gap-4 p-8 text-left hover:border-primary transition-all group">
                                <span class="text-4xl mb-2 block">
                                    {service.icon}
                                </span>
                                <h3 class="text-xl font-bold mb-2 group-hover:text-primary transition-colors">
                                    {lang === "zh"
                                        ? service.titleZh
                                        : service.titleEn}
                                </h3>
                                <p class="text-text-muted text-sm leading-relaxed">
                                    {lang === "zh"
                                        ? service.descZh
                                        : service.descEn}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Featured Posts Section -->
        {
            displayPosts.length > 0 && (
                <section class="py-20">
                    <div class="container">
                        <div class="text-center max-w-2xl mx-auto mb-16">
                            <h2 class="text-4xl md:text-5xl font-bold mb-4">
                                {t("latestInsights", lang)}
                            </h2>
                            <p class="text-text-muted text-lg">
                                {t("insightsDesc", lang)}
                            </p>
                        </div>

                        <div class="grid grid-cols-[repeat(auto-fit,minmax(320px,1fr))] gap-6">
                            {displayPosts.map((post: Post) => (
                                <BlogCard
                                    title={post.title}
                                    excerpt={post.excerpt}
                                    slug={post.slug}
                                    date={post.publishedAt}
                                    category={post.categories?.[0]?.title}
                                    image={
                                        post.featuredImage
                                            ? urlFor(post.featuredImage)
                                                  .width(800)
                                                  .height(450)
                                                  .url()
                                            : undefined
                                    }
                                    lang={lang}
                                />
                            ))}
                        </div>

                        <div class="text-center mt-12">
                            <a href={`/${lang}/blog`} class="btn btn-ghost">
                                {t("viewAllPosts", lang)}
                            </a>
                        </div>
                    </div>
                </section>
            )
        }

        <!-- CTA Section -->
        <section class="py-20">
            <div class="container">
                <div class="card-glass text-center p-8 md:p-16 rounded-[2rem]">
                    <h2 class="text-3xl md:text-4xl font-bold mb-4">
                        {t("readyToGrow", lang)}
                    </h2>
                    <p class="text-xl text-text-muted mb-8 max-w-xl mx-auto">
                        {t("ctaDesc", lang)}
                    </p>
                    <a
                        href="https://wa.me/60142836036"
                        target="_blank"
                        rel="noopener"
                        class="inline-flex items-center gap-3 px-8 py-4 bg-gradient-to-br from-[#25d366] to-[#128c7e] text-white rounded-full text-lg font-semibold transition-all shadow-[0_4px_15px_rgba(37,211,102,0.3)] hover:-translate-y-1 hover:shadow-[0_8px_25px_rgba(37,211,102,0.4)]"
                    >
                        {t("getInTouch", lang)}
                    </a>
                </div>
            </div>
        </section>

        <!-- Contact Form -->
        <ContactForm lang={lang} />
    </main>

    <Footer lang={lang} />
</BaseLayout>
