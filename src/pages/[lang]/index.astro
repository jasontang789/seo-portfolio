---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BlogCard from "../../components/BlogCard.astro";
import ContactForm from "../../components/ContactForm.astro";
import { getFeaturedPosts, urlFor } from "../../lib/sanity";
import { t, translateToZh, type SupportedLanguage } from "../../lib/translate";
import type { Post } from "../../lib/posts";

export function getStaticPaths() {
    return [{ params: { lang: "en" } }, { params: { lang: "zh" } }];
}

const { lang } = Astro.params as { lang: SupportedLanguage };

const baseTitle = "SEO Professional Portfolio | Your Name";
const baseDescription =
    "Expert SEO strategist helping businesses rank higher and grow organic traffic. Explore case studies, insights, and proven SEO methodologies.";

// Translate if Chinese
const pageTitle = lang === "zh" ? await translateToZh(baseTitle) : baseTitle;
const pageDescription =
    lang === "zh" ? await translateToZh(baseDescription) : baseDescription;

// Fetch featured posts from Sanity
const featuredPosts = await getFeaturedPosts(3);

// Translate posts if Chinese
let displayPosts = featuredPosts;
if (lang === "zh" && featuredPosts.length > 0) {
    displayPosts = await Promise.all(
        featuredPosts.map(async (post: Post) => ({
            ...post,
            title: await translateToZh(post.title),
            excerpt: await translateToZh(post.excerpt),
        })),
    );
}

const services = [
    {
        icon: "📊",
        titleEn: "Technical SEO Audits",
        titleZh: "技术SEO审计",
        descEn: "Comprehensive analysis of your website's technical health, identifying and fixing issues that impact rankings.",
        descZh: "全面分析您网站的技术健康状况，识别并修复影响排名的问题。",
    },
    {
        icon: "📝",
        titleEn: "Content Strategy",
        titleZh: "内容策略",
        descEn: "Data-driven content planning that aligns with search intent and drives qualified organic traffic.",
        descZh: "数据驱动的内容规划，与搜索意图保持一致，带来高质量的自然流量。",
    },
    {
        icon: "🔗",
        titleEn: "Link Building",
        titleZh: "链接建设",
        descEn: "Ethical, white-hat link acquisition strategies that build domain authority and trust.",
        descZh: "道德的白帽链接获取策略，建立域名权威和信任。",
    },
    {
        icon: "📈",
        titleEn: "Analytics & Reporting",
        titleZh: "分析与报告",
        descEn: "Clear, actionable insights with custom dashboards tracking the metrics that matter.",
        descZh: "清晰可执行的洞察，自定义仪表板跟踪重要指标。",
    },
];
---

<BaseLayout title={pageTitle} description={pageDescription} lang={lang}>
    <Header lang={lang} />

    <main>
        <!-- Hero Section -->
        <section class="hero">
            <div class="container">
                <div class="hero-content">
                    <span class="hero-label"
                        >{
                            lang === "zh"
                                ? "SEO策略师 & 顾问"
                                : "SEO Strategist & Consultant"
                        }</span
                    >
                    <h1 class="hero-title">
                        {t("heroTitle", lang)}
                        <span class="text-gradient"
                            >{t("heroTitleAccent", lang)}</span
                        >
                        {t("heroTitleEnd", lang)}
                    </h1>
                    <p class="hero-description">
                        {t("heroDescription", lang)}
                    </p>
                    <div class="hero-actions">
                        <a href={`/${lang}/blog`} class="btn btn-primary"
                            >{t("readInsights", lang)}</a
                        >
                        <a href={`/${lang}/about`} class="btn btn-ghost"
                            >{t("learnAboutMe", lang)}</a
                        >
                    </div>
                </div>

                <div class="hero-stats">
                    <div class="stat">
                        <span class="stat-value">150+</span>
                        <span class="stat-label"
                            >{t("projectsCompleted", lang)}</span
                        >
                    </div>
                    <div class="stat">
                        <span class="stat-value">5M+</span>
                        <span class="stat-label"
                            >{t("organicTraffic", lang)}</span
                        >
                    </div>
                    <div class="stat">
                        <span class="stat-value">8+</span>
                        <span class="stat-label"
                            >{t("yearsExperience", lang)}</span
                        >
                    </div>
                </div>
            </div>
        </section>

        <!-- Services Section -->
        <section class="section services">
            <div class="container">
                <div class="section-header">
                    <h2>{t("whatIDo", lang)}</h2>
                    <p class="text-muted">{t("servicesDesc", lang)}</p>
                </div>

                <div class="services-grid">
                    {
                        services.map((service) => (
                            <div class="service-card card">
                                <span class="service-icon">{service.icon}</span>
                                <h3>
                                    {lang === "zh"
                                        ? service.titleZh
                                        : service.titleEn}
                                </h3>
                                <p>
                                    {lang === "zh"
                                        ? service.descZh
                                        : service.descEn}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Featured Posts Section -->
        {
            displayPosts.length > 0 && (
                <section class="section posts">
                    <div class="container">
                        <div class="section-header">
                            <h2>{t("latestInsights", lang)}</h2>
                            <p class="text-muted">{t("insightsDesc", lang)}</p>
                        </div>

                        <div class="posts-grid">
                            {displayPosts.map((post: Post) => (
                                <BlogCard
                                    title={post.title}
                                    excerpt={post.excerpt}
                                    slug={post.slug}
                                    date={post.publishedAt}
                                    category={post.categories?.[0]?.title}
                                    image={
                                        post.featuredImage
                                            ? urlFor(post.featuredImage)
                                                  .width(800)
                                                  .height(450)
                                                  .url()
                                            : undefined
                                    }
                                    lang={lang}
                                />
                            ))}
                        </div>

                        <div class="section-footer">
                            <a href={`/${lang}/blog`} class="btn btn-ghost">
                                {t("viewAllPosts", lang)}
                            </a>
                        </div>
                    </div>
                </section>
            )
        }

        <!-- CTA Section -->
        <section class="section cta">
            <div class="container">
                <div class="cta-card card-glass">
                    <h2>{t("readyToGrow", lang)}</h2>
                    <p class="text-muted">{t("ctaDesc", lang)}</p>
                    <a
                        href="https://wa.me/60142836036"
                        target="_blank"
                        rel="noopener"
                        class="btn btn-whatsapp"
                    >
                        {t("getInTouch", lang)}
                    </a>
                </div>
            </div>
        </section>

        <!-- Contact Form -->
        <ContactForm lang={lang} />
    </main>

    <Footer />
</BaseLayout>

<style>
    /* Hero Section */
    .hero {
        padding: var(--space-24) 0 var(--space-16);
        min-height: 80vh;
        display: flex;
        align-items: center;
    }

    .hero-content {
        max-width: 720px;
        margin-bottom: var(--space-16);
    }

    .hero-label {
        display: inline-block;
        padding: var(--space-2) var(--space-4);
        font-size: var(--text-sm);
        font-weight: var(--font-medium);
        color: var(--color-accent);
        background: var(--color-accent-subtle);
        border-radius: var(--border-radius-full);
        margin-bottom: var(--space-6);
    }

    .hero-title {
        font-size: var(--text-6xl);
        font-weight: var(--font-bold);
        line-height: 1.1;
        margin-bottom: var(--space-6);
    }

    .hero-description {
        font-size: var(--text-lg);
        color: var(--color-text-muted);
        line-height: 1.7;
        margin-bottom: var(--space-8);
        max-width: 600px;
    }

    .hero-actions {
        display: flex;
        gap: var(--space-4);
        flex-wrap: wrap;
    }

    .hero-stats {
        display: flex;
        gap: var(--space-12);
        padding-top: var(--space-8);
        border-top: 1px solid var(--color-border);
    }

    .stat {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
    }

    .stat-value {
        font-family: var(--font-heading);
        font-size: var(--text-4xl);
        font-weight: var(--font-bold);
        color: var(--color-accent);
    }

    .stat-label {
        font-size: var(--text-sm);
        color: var(--color-text-muted);
    }

    /* Section Header */
    .section-header {
        text-align: center;
        margin-bottom: var(--space-12);
    }

    .section-header h2 {
        margin-bottom: var(--space-3);
    }

    .section-footer {
        text-align: center;
        margin-top: var(--space-10);
    }

    /* Services Grid */
    .services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: var(--space-6);
    }

    .service-card {
        text-align: center;
        padding: var(--space-8);
    }

    .service-icon {
        font-size: 2.5rem;
        margin-bottom: var(--space-4);
        display: block;
    }

    .service-card h3 {
        font-size: var(--text-lg);
        margin-bottom: var(--space-3);
    }

    .service-card p {
        color: var(--color-text-muted);
        font-size: var(--text-sm);
        line-height: 1.6;
    }

    /* Posts Grid */
    .posts-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: var(--space-6);
    }

    /* CTA Section */
    .cta-card {
        text-align: center;
        padding: var(--space-16);
        border-radius: var(--border-radius-xl);
    }

    .cta-card h2 {
        margin-bottom: var(--space-4);
    }

    .cta-card p {
        margin-bottom: var(--space-8);
        max-width: 500px;
        margin-left: auto;
        margin-right: auto;
    }

    /* WhatsApp Button */
    .btn-whatsapp {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        padding: 1rem 2rem;
        background: linear-gradient(135deg, #25d366, #128c7e);
        color: white;
        border: none;
        border-radius: 100px;
        font-size: 1.1rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(37, 211, 102, 0.3);
    }

    .btn-whatsapp:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(37, 211, 102, 0.4);
    }

    /* Responsive */
    @media (max-width: 768px) {
        .hero {
            min-height: auto;
            padding: var(--space-16) 0;
        }

        .hero-stats {
            flex-direction: column;
            gap: var(--space-6);
        }

        .stat {
            flex-direction: row;
            align-items: center;
            gap: var(--space-3);
        }

        .cta-card {
            padding: var(--space-8);
        }
    }
</style>
