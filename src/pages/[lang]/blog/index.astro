---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import BlogCard from "../../../components/BlogCard.astro";
import { getAllPosts, getAllCategories, urlFor } from "../../../lib/sanity";
import {
    t,
    translateToZh,
    type SupportedLanguage,
} from "../../../lib/translate";
import type { Post } from "../../../lib/posts";

export function getStaticPaths() {
    return [{ params: { lang: "en" } }, { params: { lang: "zh" } }];
}

const { lang } = Astro.params as { lang: SupportedLanguage };

const baseTitle = "Blog | SEO Insights & Case Studies";
const baseDescription =
    "Explore SEO strategies, case studies, and industry insights to help you improve your organic search presence.";

const pageTitle = lang === "zh" ? await translateToZh(baseTitle) : baseTitle;
const pageDescription =
    lang === "zh" ? await translateToZh(baseDescription) : baseDescription;

// Fetch posts and categories from Sanity
const allPosts = await getAllPosts();
const categories = await getAllCategories();

// Translate posts if Chinese
let displayPosts = allPosts;
if (lang === "zh" && allPosts.length > 0) {
    displayPosts = await Promise.all(
        allPosts.map(async (post: Post) => ({
            ...post,
            title: await translateToZh(post.title),
            excerpt: await translateToZh(post.excerpt),
        })),
    );
}

// Translate categories if Chinese
let displayCategories = categories;
if (lang === "zh" && categories.length > 0) {
    displayCategories = await Promise.all(
        categories.map(async (cat: any) => ({
            ...cat,
            title: await translateToZh(cat.title),
        })),
    );
}
---

<BaseLayout title={pageTitle} description={pageDescription} lang={lang}>
    <Header lang={lang} />

    <main class="min-h-screen">
        <!-- Blog Header -->
        <section class="py-24 text-center">
            <div class="container">
                <span
                    class="inline-block px-4 py-2 text-sm font-medium text-primary bg-primary/10 rounded-full mb-6"
                    >{t("blog", lang)}</span
                >
                <h1 class="text-5xl font-bold mb-4">
                    {lang === "zh" ? "SEO见解与" : "SEO Insights &"}
                    <span class="text-gradient"
                        >{lang === "zh" ? "案例研究" : "Case Studies"}</span
                    >
                </h1>
                <p
                    class="text-xl text-text-muted max-w-2xl mx-auto leading-relaxed"
                >
                    {
                        lang === "zh"
                            ? "实用的SEO策略、真实案例研究和行业分析，帮助您提升自然搜索排名。"
                            : "Practical SEO strategies, real-world case studies, and industry analysis to help you grow your organic presence."
                    }
                </p>
            </div>
        </section>

        <!-- Categories Filter -->
        {
            displayCategories.length > 0 && (
                <section class="py-6 border-y border-border bg-surface">
                    <div class="container">
                        <div class="flex flex-wrap justify-center gap-3">
                            <button
                                class="px-4 py-2 text-sm font-medium rounded-full border transition-colors cursor-pointer text-primary border-primary bg-primary/10"
                                data-category="all"
                            >
                                {t("allPosts", lang)}
                            </button>
                            {displayCategories.map((category: any) => (
                                <button
                                    class="px-4 py-2 text-sm font-medium rounded-full border border-border bg-transparent text-text-muted transition-colors cursor-pointer hover:text-primary hover:border-primary hover:bg-primary/10"
                                    data-category={category.slug}
                                >
                                    {category.title}
                                </button>
                            ))}
                        </div>
                    </div>
                </section>
            )
        }

        <!-- Blog Grid -->
        <section class="py-20">
            <div class="container">
                {
                    displayPosts.length > 0 ? (
                        <div class="grid grid-cols-[repeat(auto-fit,minmax(320px,1fr))] gap-8">
                            {displayPosts.map((post: Post) => (
                                <BlogCard
                                    title={post.title}
                                    excerpt={post.excerpt}
                                    slug={post.slug}
                                    date={post.publishedAt}
                                    category={post.categories?.[0]?.title}
                                    image={
                                        post.featuredImage
                                            ? urlFor(post.featuredImage)
                                                  .width(800)
                                                  .height(450)
                                                  .url()
                                            : undefined
                                    }
                                    lang={lang}
                                />
                            ))}
                        </div>
                    ) : (
                        <div class="text-center py-24 bg-surface rounded-xl border border-dashed border-border text-text-muted">
                            <h3 class="text-2xl font-bold mb-4 text-text">
                                {t("noPosts", lang)}
                            </h3>
                            <p>{t("noPostsDesc", lang)}</p>
                        </div>
                    )
                }
            </div>
        </section>
    </main>

    <Footer lang={lang} />
</BaseLayout>
