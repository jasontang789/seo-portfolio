---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { getAllPosts, getPostBySlug, urlFor } from "../../../lib/sanity";
import { formatDate, calculateReadTime, type Post } from "../../../lib/posts";
import {
    t,
    translateToZh,
    type SupportedLanguage,
} from "../../../lib/translate";

// Required for static site generation - fetch all post slugs from Sanity
export async function getStaticPaths() {
    const posts = await getAllPosts();
    const paths = [];

    for (const post of posts) {
        // Generate paths for both languages
        paths.push({
            params: { lang: "en", slug: post.slug },
            props: { post, lang: "en" },
        });
        paths.push({
            params: { lang: "zh", slug: post.slug },
            props: { post, lang: "zh" },
        });
    }

    return paths;
}

interface Props {
    post: Post;
    lang: SupportedLanguage;
}

const { post, lang } = Astro.props;
const fullPost = await getPostBySlug(post.slug);

// Translate content if Chinese
let displayPost = fullPost;
if (lang === "zh") {
    displayPost = {
        ...fullPost,
        title: await translateToZh(fullPost.title),
        excerpt: await translateToZh(fullPost.excerpt),
    };
}

const formattedDate = formatDate(displayPost.publishedAt);
const readTime = calculateReadTime(displayPost.content);
const imageUrl = displayPost.featuredImage
    ? urlFor(displayPost.featuredImage).width(1200).height(600).url()
    : null;

// Helper function to convert Portable Text to HTML
function renderPortableText(blocks: any[]): string {
    if (!blocks || !Array.isArray(blocks)) return "";

    return blocks
        .map((block) => {
            if (block._type !== "block") {
                // Handle images
                if (block._type === "image") {
                    const imgUrl = urlFor(block).width(800).url();
                    return `<figure><img src="${imgUrl}" alt="${block.alt || ""}" />${block.caption ? `<figcaption>${block.caption}</figcaption>` : ""}</figure>`;
                }
                return "";
            }

            // Handle text blocks
            const style = block.style || "normal";
            const children =
                block.children
                    ?.map((child: any) => {
                        let text = child.text || "";

                        // Apply marks (bold, italic, etc.)
                        if (child.marks) {
                            child.marks.forEach((mark: string) => {
                                if (mark === "strong")
                                    text = `<strong>${text}</strong>`;
                                if (mark === "em") text = `<em>${text}</em>`;
                                if (mark === "code")
                                    text = `<code>${text}</code>`;
                            });
                        }
                        return text;
                    })
                    .join("") || "";

            // Map styles to HTML tags
            switch (style) {
                case "h2":
                    return `<h2 class="text-3xl md:text-4xl font-bold mt-12 mb-6 text-text">${children}</h2>`;
                case "h3":
                    return `<h3 class="text-2xl md:text-3xl font-semibold mt-10 mb-4 text-text">${children}</h3>`;
                case "h4":
                    return `<h4 class="text-xl md:text-2xl font-semibold mt-8 mb-3 text-text">${children}</h4>`;
                case "blockquote":
                    return `<blockquote>${children}</blockquote>`;
                default:
                    return `<p>${children}</p>`;
            }
        })
        .join("\n");
}

// Translate content blocks if Chinese
async function getTranslatedContent() {
    if (lang !== "zh" || !fullPost.content)
        return renderPortableText(fullPost.content);

    const htmlContent = renderPortableText(fullPost.content);
    return await translateToZh(htmlContent);
}

const translatedContent = await getTranslatedContent();
---

<BaseLayout
    title={`${displayPost.seo?.metaTitle || displayPost.title} | SEO Portfolio`}
    description={displayPost.seo?.metaDescription || displayPost.excerpt}
    ogImage={imageUrl || undefined}
    lang={lang}
>
    <Header lang={lang} />

    <main>
        <article class="article">
            <!-- Article Header -->
            <header class="py-24 pb-8">
                <div class="container container-content">
                    <a
                        href={`/${lang}/blog`}
                        class="inline-block text-sm text-text-muted mb-6 transition-colors hover:text-primary"
                        >{t("backToBlog", lang)}</a
                    >
                    <div class="mb-4">
                        {
                            displayPost.categories?.[0] && (
                                <span class="inline-block px-3 py-1 text-xs font-medium text-primary bg-primary/10 rounded-full">
                                    {displayPost.categories[0].title}
                                </span>
                            )
                        }
                    </div>
                    <h1
                        class="text-4xl md:text-5xl font-bold leading-tight mb-4"
                    >
                        {displayPost.title}
                    </h1>
                    <div
                        class="flex items-center gap-3 text-text-muted text-sm"
                    >
                        <time datetime={displayPost.publishedAt}
                            >{formattedDate}</time
                        >
                        <span class="opacity-50">•</span>
                        <span>{readTime}</span>
                    </div>
                </div>
            </header>

            <!-- Featured Image -->
            {
                imageUrl && (
                    <div class="mb-12">
                        <div class="container">
                            <img
                                src={imageUrl}
                                alt={
                                    displayPost.featuredImage?.alt ||
                                    displayPost.title
                                }
                                class="w-full rounded-lg"
                            />
                        </div>
                    </div>
                )
            }

            <!-- Article Content -->
            <div class="pb-16">
                <div class="container container-content">
                    <div
                        class="prose max-w-3xl mx-auto text-lg leading-relaxed text-text [&>h2]:text-2xl [&>h2]:font-bold [&>h2]:mt-10 [&>h2]:mb-4 [&>h3]:text-xl [&>h3]:font-semibold [&>h3]:mt-8 [&>h3]:mb-3 [&>p]:mb-6 [&>ul]:mb-6 [&>ul]:pl-8 [&>ul]:list-disc [&>ol]:mb-6 [&>ol]:pl-8 [&>ol]:list-decimal [&>li]:mb-2 [&>blockquote]:border-l-4 [&>blockquote]:border-accent [&>blockquote]:pl-6 [&>blockquote]:italic [&>blockquote]:text-text-muted [&>blockquote]:my-8 [&>code]:bg-surface [&>code]:px-2 [&>code]:py-1 [&>code]:rounded-sm [&>code]:text-[0.9em] [&>pre]:bg-surface [&>pre]:p-6 [&>pre]:rounded-md [&>pre]:overflow-x-auto [&>pre]:my-8 [&>figure]:my-8 [&>figure_img]:w-full [&>figure_img]:rounded-md [&>figcaption]:text-center [&>figcaption]:text-sm [&>figcaption]:text-text-muted [&>figcaption]:mt-3"
                        id="content"
                    >
                        {
                            translatedContent ? (
                                <div set:html={translatedContent} />
                            ) : (
                                <p>
                                    {lang === "zh"
                                        ? "暂无内容。"
                                        : "No content available."}
                                </p>
                            )
                        }
                    </div>
                </div>
            </div>

            <!-- Article Footer -->
            <footer class="border-t border-border py-8">
                <div class="container container-content">
                    <div class="flex items-center gap-4 flex-wrap">
                        <span class="text-sm text-text-muted"
                            >{t("shareArticle", lang)}</span
                        >
                        <div class="flex gap-3">
                            <a
                                href="#"
                                class="px-4 py-2 text-sm text-text bg-surface border border-border rounded-md no-underline transition-colors hover:border-primary hover:text-primary"
                                aria-label="Share on Twitter">Twitter</a
                            >
                            <a
                                href="#"
                                class="px-4 py-2 text-sm text-text bg-surface border border-border rounded-md no-underline transition-colors hover:border-primary hover:text-primary"
                                aria-label="Share on LinkedIn">LinkedIn</a
                            >
                            <a
                                href="#"
                                class="px-4 py-2 text-sm text-text bg-surface border border-border rounded-md no-underline transition-colors hover:border-primary hover:text-primary"
                                aria-label="Copy link">{t("copyLink", lang)}</a
                            >
                        </div>
                    </div>
                </div>
            </footer>
        </article>
    </main>

    <Footer lang={lang} />
</BaseLayout>
