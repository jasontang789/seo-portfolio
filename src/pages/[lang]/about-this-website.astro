---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { t, type SupportedLanguage } from "../../lib/translate";

export function getStaticPaths() {
    return [{ params: { lang: "en" } }, { params: { lang: "zh" } }];
}

const { lang } = Astro.params as { lang: SupportedLanguage };

const content = {
    en: {
        title: "About This Website | The Building Process",
        description:
            "A detailed case study of building my SEO portfolio website, including challenges, technical setup, learning process, and real performance outcomes.",
        heading: "Building This Website",
        intro: "This portfolio is more than just a showcase of work; it's a testament to modern web development practices, combining performance, design, and SEO from the ground up.",
        stack: {
            title: "The Tech Stack",
            items: [
                {
                    name: "Astro",
                    desc: "For zero-JavaScript default and extreme performance.",
                },
                {
                    name: "Sanity CMS",
                    desc: "For structured, headless content management.",
                },
                {
                    name: "Cloudflare Pages",
                    desc: "For edge deployment and speed.",
                },
                {
                    name: "Gemini AI",
                    desc: "Powering real-time translation and content generation.",
                },
            ],
        },
        challenges: {
            title: "Challenges & Solutions",
            items: [
                {
                    problem: "Bilingual Support",
                    solution:
                        "We implemented a custom routing system `/[lang]/...` and integrated Google's Gemini API to assist with translations, ensuring content reaches a wider audience without manual duplication.",
                },
                {
                    problem: "Contact Form Security",
                    solution:
                        "Initially exploring custom reCAPTCHA v3, we pivoted to Web3Forms for a robust, serverless solution that handles spam protection natively, keeping the site static and fast.",
                },
                {
                    problem: "Performance vs. Design",
                    solution:
                        "Achieving a glassmorphism design with rich visual effects usually comes at a performance cost. By using optimized CSS variables and minimal client-side JavaScript, we maintained high Lighthouse scores.",
                },
            ],
        },
        outcome: {
            title: "The Outcome",
            text: "The result is a lightning-fast, SEO-optimized portfolio that serves as a living case study of the principles I apply to client projects: technical excellence backing great content.",
        },
    },
    zh: {
        title: "关于本站 | 建站过程",
        description:
            "构建SEO作品集网站的详细案例研究，包括挑战、技术设置、学习过程和实际性能成果。",
        heading: "关于本站的构建",
        intro: "这个作品集不仅仅是工作的展示；它是现代Web开发实践的证明，从底层结合了性能、设计和SEO。",
        stack: {
            title: "技术栈",
            items: [
                { name: "Astro", desc: "实现零JavaScript默认设置和极致性能。" },
                { name: "Sanity CMS", desc: "用于结构化的无头内容管理。" },
                { name: "Cloudflare Pages", desc: "实现边缘部署和极速访问。" },
                { name: "Gemini AI", desc: "支持实时翻译和内容生成。" },
            ],
        },
        challenges: {
            title: "挑战与解决方案",
            items: [
                {
                    problem: "双语支持",
                    solution:
                        "我们实施了自定义路由系统 `/[lang]/...` 并集成了Google Gemini API辅助翻译，确保内容无需手动复制即可覆盖更广泛的受众。",
                },
                {
                    problem: "联系表单安全",
                    solution:
                        "最初探索自定义reCAPTCHA v3，后来为了保持网站的静态和快速，我们转向Web3Forms，这是一种强大的无服务器解决方案，原生处理反垃圾邮件。",
                },
                {
                    problem: "性能与设计的平衡",
                    solution:
                        "实现具有丰富视觉效果的玻璃拟态设计通常会牺牲性能。通过使用优化的CSS变量和极少的客户端JavaScript，我们保持了高Lighthouse分数。",
                },
            ],
        },
        outcome: {
            title: "最终成果",
            text: "结果是一个极速、SEO优化的作品集，它作为我应用于客户项目的原则的活生生的案例研究：卓越的技术支持优质的内容。",
        },
    },
};

const c = content[lang];
---

<BaseLayout title={c.title} description={c.description} lang={lang}>
    <Header lang={lang} />

    <main class="min-h-screen">
        <section class="py-24 text-center">
            <div class="container">
                <span
                    class="inline-block px-4 py-2 text-sm font-medium text-primary bg-primary/10 rounded-full mb-6"
                    >{t("aboutThisWebsite", lang)}</span
                >
                <h1 class="text-5xl font-bold mb-6">{c.heading}</h1>
                <p
                    class="text-xl text-text-muted max-w-2xl mx-auto leading-relaxed"
                >
                    {c.intro}
                </p>
            </div>
        </section>

        <section class="py-12">
            <div class="container">
                <div class="grid gap-12 mb-16">
                    <!-- Tech Stack -->
                    <div class="card p-8 bg-surface">
                        <h2 class="text-2xl font-bold">{c.stack.title}</h2>
                        <ul
                            class="list-none p-0 grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-6 mt-6"
                        >
                            {
                                c.stack.items.map((item) => (
                                    <li>
                                        <strong class="block text-primary mb-2 text-lg">
                                            {item.name}
                                        </strong>
                                        <p class="text-text-muted">
                                            {item.desc}
                                        </p>
                                    </li>
                                ))
                            }
                        </ul>
                    </div>

                    <!-- Challenges -->
                    <div class="mt-8">
                        <h2 class="text-2xl font-bold">{c.challenges.title}</h2>
                        <div
                            class="grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-6 mt-6"
                        >
                            {
                                c.challenges.items.map((item) => (
                                    <div class="card-glass p-6">
                                        <h3 class="text-xl font-bold text-text mb-3">
                                            {item.problem}
                                        </h3>
                                        <p class="text-text-muted">
                                            {item.solution}
                                        </p>
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                </div>

                <!-- Outcome -->
                <div class="bg-primary/10 p-12 rounded-xl text-center">
                    <div class="max-w-4xl mx-auto">
                        <h2 class="text-3xl font-bold mb-8 text-primary">
                            {c.outcome.title}
                        </h2>
                        <p class="text-lg leading-relaxed mb-12">
                            {c.outcome.text}
                        </p>

                        <div class="grid md:grid-cols-2 gap-8 items-start">
                            <div class="space-y-4">
                                <div
                                    class="relative group rounded-xl overflow-hidden border border-white/10 bg-surface/50"
                                >
                                    <div
                                        class="absolute inset-0 bg-primary/5 group-hover:bg-primary/10 transition-colors"
                                    >
                                    </div>
                                    <img
                                        src="/images/about-website/lighthouse-mobile-result.png"
                                        alt="Mobile Lighthouse Performance Score: 92 Performance, 94 Accessibility, 96 Best Practices, 100 SEO"
                                        class="w-full h-auto relative z-10"
                                    />
                                </div>
                                <p
                                    class="text-sm text-text-muted font-medium uppercase tracking-wider"
                                >
                                    {
                                        lang === "zh"
                                            ? "移动端结果"
                                            : "Mobile Result"
                                    }
                                </p>
                            </div>

                            <div class="space-y-4">
                                <div
                                    class="relative group rounded-xl overflow-hidden border border-white/10 bg-surface/50"
                                >
                                    <div
                                        class="absolute inset-0 bg-primary/5 group-hover:bg-primary/10 transition-colors"
                                    >
                                    </div>
                                    <img
                                        src="/images/about-website/lighthouse-desktop-result.png"
                                        alt="Desktop Lighthouse Performance Score: 99 Performance, 94 Accessibility, 96 Best Practices, 100 SEO"
                                        class="w-full h-auto relative z-10"
                                    />
                                </div>
                                <p
                                    class="text-sm text-text-muted font-medium uppercase tracking-wider"
                                >
                                    {
                                        lang === "zh"
                                            ? "桌面端结果"
                                            : "Desktop Result"
                                    }
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <Footer lang={lang} />
</BaseLayout>
