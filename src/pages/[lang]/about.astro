---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { t, type SupportedLanguage } from "../../lib/translate";

export function getStaticPaths() {
    return [{ params: { lang: "en" } }, { params: { lang: "zh" } }];
}

const { lang } = Astro.params as { lang: SupportedLanguage };

const content = {
    en: {
        title: "About Me | SEO Professional",
        description:
            "Learn about my background in SEO, my approach to search optimization, and how I can help your business grow.",
        heading: "About Me",
        subheading: "SEO Strategist & Consultant",
        intro: "I'm a passionate SEO professional with over 8 years of experience helping businesses improve their organic search presence. My data-driven approach combines technical expertise with creative content strategies.",
        skills: [
            "Technical SEO Audits",
            "Content Strategy",
            "Link Building",
            "Analytics & Reporting",
        ],
        experience:
            "With a track record of delivering results for clients across various industries, I specialize in transforming websites into high-performing organic traffic machines.",
    },
    zh: {
        title: "关于我 | SEO专家",
        description:
            "了解我在SEO方面的背景、我的搜索优化方法以及我如何帮助您的业务增长。",
        heading: "关于我",
        subheading: "SEO策略师与顾问",
        intro: "我是一位充满热情的SEO专业人士，拥有超过8年帮助企业改善自然搜索排名的经验。我的数据驱动方法将技术专业知识与创意内容策略相结合。",
        skills: ["技术SEO审计", "内容策略", "链接建设", "分析与报告"],
        experience:
            "凭借为各行各业客户交付成果的良好记录，我专注于将网站转变为高性能的自然流量引擎。",
    },
};

const c = content[lang];
---

<BaseLayout title={c.title} description={c.description} lang={lang}>
    <Header lang={lang} />

    <main>
        <section class="py-24 text-center">
            <div class="container">
                <span
                    class="inline-block px-4 py-2 text-sm font-medium text-primary bg-primary/10 rounded-full mb-6"
                    >{c.subheading}</span
                >
                <h1 class="text-5xl font-bold mb-8">{c.heading}</h1>
            </div>
        </section>

        <section class="py-12">
            <div class="container max-w-3xl">
                <div class="mb-12">
                    <p class="text-xl leading-relaxed text-text-muted">
                        {c.intro}
                    </p>
                </div>

                <div class="mb-12">
                    <h2 class="text-3xl font-bold mb-6">
                        {lang === "zh" ? "我的专长" : "My Expertise"}
                    </h2>
                    <div
                        class="grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-4"
                    >
                        {
                            c.skills.map((skill) => (
                                <div class="card flex items-center gap-3 p-4">
                                    <span class="text-primary font-bold">
                                        ✓
                                    </span>
                                    <span>{skill}</span>
                                </div>
                            ))
                        }
                    </div>
                </div>

                <div class="mb-12 text-lg leading-relaxed text-text-muted">
                    <p>{c.experience}</p>
                </div>

                <div class="text-center">
                    <a
                        href="https://wa.me/60142836036"
                        target="_blank"
                        rel="noopener"
                        class="btn btn-primary"
                    >
                        {t("getInTouch", lang)}
                    </a>
                </div>
            </div>
        </section>
    </main>

    <Footer lang={lang} />
</BaseLayout>
