---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const pageTitle = "About Me | SEO Professional Portfolio";
const pageDescription =
    "Learn about my journey as an SEO professional, my approach to search engine optimization, and how I help businesses grow their organic presence.";

const skills = [
    { name: "Technical SEO", level: 95 },
    { name: "Content Strategy", level: 90 },
    { name: "Keyword Research", level: 95 },
    { name: "Link Building", level: 85 },
    { name: "Analytics & Reporting", level: 90 },
    { name: "Local SEO", level: 85 },
];

const experience = [
    {
        role: "Senior SEO Consultant",
        company: "Freelance",
        period: "2022 - Present",
        description:
            "Helping businesses across various industries improve their organic visibility through comprehensive SEO strategies.",
    },
    {
        role: "SEO Lead",
        company: "Digital Agency",
        period: "2019 - 2022",
        description:
            "Led SEO initiatives for 50+ clients, managing a team of specialists and driving measurable results.",
    },
    {
        role: "SEO Specialist",
        company: "Tech Startup",
        period: "2017 - 2019",
        description:
            "Built SEO foundations from scratch, growing organic traffic from 0 to 100K monthly visitors.",
    },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
    <Header />

    <main>
        <!-- About Hero -->
        <section class="about-hero">
            <div class="container">
                <div class="about-content">
                    <span class="hero-label">About Me</span>
                    <h1>
                        Passionate About <span class="text-gradient"
                            >Search Excellence</span>
                    </h1>
                    <p class="about-intro">
                        I'm an SEO professional with over 8 years of experience
                        helping businesses unlock their organic growth
                        potential. My approach combines technical expertise with
                        creative strategy to deliver results that matter.
                    </p>
                </div>
            </div>
        </section>

        <!-- Story Section -->
        <section class="section story">
            <div class="container container-content">
                <h2>My Journey</h2>
                <div class="story-content">
                    <p>
                        My fascination with SEO began when I realized how
                        powerful organic search could be for businesses of all
                        sizes. Unlike paid advertising, SEO builds lasting
                        value—creating assets that continue to drive traffic and
                        revenue year after year.
                    </p>
                    <p>
                        Over the years, I've worked with startups, SMEs, and
                        enterprise clients across e-commerce, SaaS, healthcare,
                        and professional services. This diverse experience has
                        given me a unique perspective on what works across
                        different industries and business models.
                    </p>
                    <p>
                        I believe in transparency, data-driven decisions, and
                        strategies that align with your business goals—not just
                        vanity metrics. When we work together, you'll always
                        know exactly what we're doing and why.
                    </p>
                </div>
            </div>
        </section>

        <!-- Skills Section -->
        <section class="section skills">
            <div class="container">
                <div class="section-header">
                    <h2>Core Competencies</h2>
                    <p class="text-muted">
                        Areas where I deliver the most value
                    </p>
                </div>

                <div class="skills-grid">
                    {
                        skills.map((skill) => (
                            <div class="skill-item">
                                <div class="skill-header">
                                    <span class="skill-name">{skill.name}</span>
                                    <span class="skill-level">
                                        {skill.level}%
                                    </span>
                                </div>
                                <div class="skill-bar">
                                    <div
                                        class="skill-progress"
                                        style={`width: ${skill.level}%`}
                                    />
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Experience Section -->
        <section class="section experience">
            <div class="container container-content">
                <div class="section-header">
                    <h2>Experience</h2>
                </div>

                <div class="timeline">
                    {
                        experience.map((item, index) => (
                            <div class="timeline-item">
                                <div class="timeline-marker" />
                                <div class="timeline-content card">
                                    <span class="timeline-period">
                                        {item.period}
                                    </span>
                                    <h3>{item.role}</h3>
                                    <span class="timeline-company">
                                        {item.company}
                                    </span>
                                    <p>{item.description}</p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Approach Section -->
        <section class="section approach">
            <div class="container">
                <div class="approach-grid">
                    <div class="approach-content">
                        <h2>My Approach</h2>
                        <p>
                            I don't believe in one-size-fits-all SEO. Every
                            business is unique, and your SEO strategy should
                            reflect that.
                        </p>
                        <ul class="approach-list">
                            <li>
                                <strong>Data-First:</strong> Every recommendation
                                is backed by data, not assumptions or outdated best
                                practices.
                            </li>
                            <li>
                                <strong>Holistic Strategy:</strong> Technical SEO,
                                content, and off-page work together—not in silos.
                            </li>
                            <li>
                                <strong>Sustainable Growth:</strong> I focus on white-hat
                                techniques that build long-term value.
                            </li>
                            <li>
                                <strong>Clear Communication:</strong> You'll always
                                understand what we're doing and the results we're
                                achieving.
                            </li>
                        </ul>
                    </div>
                    <div class="approach-visual card-glass">
                        <div class="approach-stat">
                            <span class="stat-number">300%</span>
                            <span class="stat-text"
                                >Average Traffic Increase</span
                            >
                        </div>
                        <div class="approach-stat">
                            <span class="stat-number">Top 10</span>
                            <span class="stat-text">Ranking Improvements</span>
                        </div>
                        <div class="approach-stat">
                            <span class="stat-number">5x</span>
                            <span class="stat-text">ROI on SEO Investment</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA -->
        <section class="section cta">
            <div class="container">
                <div class="cta-card card-glass">
                    <h2>Let's Work Together</h2>
                    <p class="text-muted">
                        Ready to take your organic presence to the next level?
                        I'd love to hear about your project.
                    </p>
                    <a href="mailto:hello@example.com" class="btn btn-primary"
                        >Get in Touch</a
                    >
                </div>
            </div>
        </section>
    </main>

    <Footer />
</BaseLayout>

<style>
    /* About Hero */
    .about-hero {
        padding: var(--space-24) 0 var(--space-16);
    }

    .about-content {
        max-width: 720px;
    }

    .hero-label {
        display: inline-block;
        padding: var(--space-2) var(--space-4);
        font-size: var(--text-sm);
        font-weight: var(--font-medium);
        color: var(--color-accent);
        background: var(--color-accent-subtle);
        border-radius: var(--border-radius-full);
        margin-bottom: var(--space-6);
    }

    .about-hero h1 {
        font-size: var(--text-5xl);
        margin-bottom: var(--space-6);
    }

    .about-intro {
        font-size: var(--text-lg);
        color: var(--color-text-muted);
        line-height: 1.7;
    }

    /* Story Section */
    .story h2 {
        margin-bottom: var(--space-8);
    }

    .story-content p {
        color: var(--color-text-muted);
        line-height: 1.8;
        margin-bottom: var(--space-6);
    }

    .story-content p:last-child {
        margin-bottom: 0;
    }

    /* Skills Section */
    .section-header {
        text-align: center;
        margin-bottom: var(--space-12);
    }

    .section-header h2 {
        margin-bottom: var(--space-3);
    }

    .skills-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: var(--space-6);
        max-width: 800px;
        margin: 0 auto;
    }

    .skill-item {
        padding: var(--space-4) 0;
    }

    .skill-header {
        display: flex;
        justify-content: space-between;
        margin-bottom: var(--space-2);
    }

    .skill-name {
        font-weight: var(--font-medium);
    }

    .skill-level {
        color: var(--color-accent);
        font-weight: var(--font-semibold);
    }

    .skill-bar {
        height: 8px;
        background: var(--color-border);
        border-radius: var(--border-radius-full);
        overflow: hidden;
    }

    .skill-progress {
        height: 100%;
        background: linear-gradient(90deg, var(--color-accent), #8b5cf6);
        border-radius: var(--border-radius-full);
        transition: width 1s ease;
    }

    /* Timeline */
    .timeline {
        position: relative;
        padding-left: var(--space-8);
    }

    .timeline::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 2px;
        background: var(--color-border);
    }

    .timeline-item {
        position: relative;
        margin-bottom: var(--space-8);
    }

    .timeline-item:last-child {
        margin-bottom: 0;
    }

    .timeline-marker {
        position: absolute;
        left: calc(-1 * var(--space-8) - 5px);
        top: var(--space-6);
        width: 12px;
        height: 12px;
        background: var(--color-accent);
        border-radius: 50%;
        border: 2px solid var(--color-bg);
    }

    .timeline-content {
        padding: var(--space-6);
    }

    .timeline-period {
        display: inline-block;
        font-size: var(--text-sm);
        color: var(--color-accent);
        font-weight: var(--font-medium);
        margin-bottom: var(--space-2);
    }

    .timeline-content h3 {
        font-size: var(--text-xl);
        margin-bottom: var(--space-1);
    }

    .timeline-company {
        display: block;
        color: var(--color-text-muted);
        font-size: var(--text-sm);
        margin-bottom: var(--space-3);
    }

    .timeline-content p {
        color: var(--color-text-muted);
        font-size: var(--text-sm);
        line-height: 1.6;
    }

    /* Approach Section */
    .approach-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-12);
        align-items: center;
    }

    .approach-content h2 {
        margin-bottom: var(--space-4);
    }

    .approach-content > p {
        color: var(--color-text-muted);
        margin-bottom: var(--space-6);
    }

    .approach-list {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
    }

    .approach-list li {
        line-height: 1.6;
        color: var(--color-text-muted);
    }

    .approach-list strong {
        color: var(--color-text);
    }

    .approach-visual {
        padding: var(--space-8);
        border-radius: var(--border-radius-xl);
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
    }

    .approach-stat {
        text-align: center;
        padding: var(--space-4);
    }

    .stat-number {
        display: block;
        font-family: var(--font-heading);
        font-size: var(--text-3xl);
        font-weight: var(--font-bold);
        color: var(--color-accent);
        margin-bottom: var(--space-1);
    }

    .stat-text {
        font-size: var(--text-sm);
        color: var(--color-text-muted);
    }

    /* CTA */
    .cta-card {
        text-align: center;
        padding: var(--space-16);
        border-radius: var(--border-radius-xl);
    }

    .cta-card h2 {
        margin-bottom: var(--space-4);
    }

    .cta-card p {
        margin-bottom: var(--space-8);
        max-width: 500px;
        margin-left: auto;
        margin-right: auto;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .approach-grid {
            grid-template-columns: 1fr;
        }

        .timeline {
            padding-left: var(--space-6);
        }

        .timeline-marker {
            left: calc(-1 * var(--space-6) - 5px);
        }

        .cta-card {
            padding: var(--space-8);
        }
    }
</style>
