---
import "../styles/global.css";
import type { SupportedLanguage } from "../lib/translate";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  lang?: SupportedLanguage;
}

const {
  title,
  description = "SEO Professional Portfolio - Showcasing expertise in search engine optimization, content strategy, and digital marketing.",
  ogImage = "/og-image.webp",
  lang = "en",
} = Astro.props;

const siteUrl = Astro.site || "https://seo-portfolio.pages.dev";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);

// Determine the HTML lang attribute
const htmlLang = lang === "zh" ? "zh-CN" : "en";
---

<!doctype html>
<html lang={htmlLang} data-lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Tag Manager -->
    <!-- Google Tag Manager (Deferred for Performance) -->
    <script is:inline>
      setTimeout(function () {
        (function (w, d, s, l, i) {
          w[l] = w[l] || [];
          w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
          var f = d.getElementsByTagName(s)[0],
            j = d.createElement(s),
            dl = l != "dataLayer" ? "&l=" + l : "";
          j.async = true;
          j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
          f.parentNode.insertBefore(j, f);
        })(window, document, "script", "dataLayer", "GTM-TSCM9MFC");
      }, 3500);
    </script>
    <!-- End Google Tag Manager -->

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Language alternates for SEO -->
    <link
      rel="alternate"
      hreflang="en"
      href={new URL(Astro.url.pathname.replace(/^\/(en|zh)/, "/en"), siteUrl)}
    />
    <link
      rel="alternate"
      hreflang="zh"
      href={new URL(Astro.url.pathname.replace(/^\/(en|zh)/, "/zh"), siteUrl)}
    />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(Astro.url.pathname.replace(/^\/(en|zh)/, "/en"), siteUrl)}
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, siteUrl)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="627" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:locale" content={lang === "zh" ? "zh_CN" : "en_US"} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, siteUrl)} />

    <!-- Fonts: Inter + Montserrat (Async Load) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@600;700;800&display=swap"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@600;700;800&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- Chinese Font: Ma Shan Zheng (Conditional & Async) -->
    {
      lang === "zh" && (
        <>
          <link
            rel="preload"
            href="https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng&display=swap"
            as="style"
            onload="this.onload=null;this.rel='stylesheet'"
          />
          <noscript>
            <link
              href="https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng&display=swap"
              rel="stylesheet"
            />
          </noscript>
        </>
      )
    }

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Theme Script (runs before render to prevent flash) -->
    <script is:inline>
      const theme = localStorage.getItem("theme") || "dark";
      document.documentElement.setAttribute("data-theme", theme);
    </script>

    <!-- Language-specific styles -->
    <style is:inline>
      /* Chinese font for zh pages */
      [data-lang="zh"] {
        --font-heading: "Ma Shan Zheng", cursive;
        --font-body: "Inter", -apple-system, sans-serif;
      }

      [data-lang="zh"] h1,
      [data-lang="zh"] h2,
      [data-lang="zh"] h3,
      [data-lang="zh"] h4,
      [data-lang="zh"] h5,
      [data-lang="zh"] h6 {
        font-family: "Ma Shan Zheng", cursive;
        font-weight: 400;
      }
    </style>
  </head>
  <body
    class="text-text font-body selection:bg-primary/30 selection:text-text relative overflow-x-hidden"
  >
    <!-- Full Width Gradient Background -->
    <div
      class="fixed inset-0 z-[-1] bg-background pointer-events-none transition-colors duration-300"
    >
      <!-- Main Gradient Mesh -->
      <div
        class="absolute inset-0 bg-gradient-to-br from-indigo-500/30 via-transparent to-purple-500/30 animate-fade-in"
      >
      </div>

      <!-- Orb Accents (Blended) -->
      <div
        class="absolute top-[-20%] left-[-10%] w-[50%] h-[50%] rounded-full bg-blue-600/10 blur-[120px] animate-pulse-slow"
      >
      </div>
      <div
        class="absolute bottom-[-20%] right-[-10%] w-[50%] h-[50%] rounded-full bg-purple-600/10 blur-[120px] animate-pulse-slow delay-1000"
      >
      </div>

      <!-- Overlay Texture -->
      <div
        class="absolute inset-0 opacity-[0.03] bg-[url('/noise.png')] mix-blend-overlay"
      >
      </div>
    </div>
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-TSCM9MFC"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->

    <slot />

    <!-- Theme Toggle Script -->
    <script is:inline>
      function toggleTheme() {
        const html = document.documentElement;
        const currentTheme = html.getAttribute("data-theme");
        const newTheme = currentTheme === "dark" ? "light" : "dark";
        html.setAttribute("data-theme", newTheme);
        localStorage.setItem("theme", newTheme);
      }

      // Make toggleTheme available globally
      window.toggleTheme = toggleTheme;
    </script>
  </body>
</html>
