---
import { t, type SupportedLanguage } from "../lib/translate";

interface Props {
    lang?: SupportedLanguage;
}

const { lang = "en" } = Astro.props;

const currentYear = new Date().getFullYear();

const socialLinks = [
    {
        label: "LinkedIn",
        href: "https://www.linkedin.com/in/tang-kee-qian-a99132243/",
        icon: "linkedin",
    },
    {
        label: "TikTok",
        href: "https://www.tiktok.com/@cccc.jason",
        icon: "tiktok",
    },
];
---

<footer class="bg-surface border-t border-border mt-auto pt-16 pb-8">
    <div class="container">
        <div
            class="grid grid-cols-1 md:grid-cols-[1.5fr_1fr] gap-8 md:gap-12 mb-12"
        >
            <div class="max-w-xs">
                <a
                    href={`/${lang}`}
                    class="inline-block font-heading text-xl font-bold text-text no-underline mb-4"
                >
                    <span class="text-text"
                        >SEO<span class="text-primary">Pro</span></span
                    >
                </a>
                <p class="text-text-muted text-sm leading-relaxed">
                    Helping businesses grow through strategic SEO and content
                    optimization.
                </p>
            </div>

            <div class="grid grid-cols-2 gap-8">
                <div class="flex flex-col">
                    <h4
                        class="font-heading text-sm font-semibold text-text mb-4 uppercase tracking-wider"
                    >
                        Navigation
                    </h4>
                    <ul class="flex flex-col gap-3">
                        <li>
                            <a
                                href={`/${lang}`}
                                class="text-text-muted text-sm no-underline transition-colors hover:text-primary"
                                >{t("home", lang)}</a
                            >
                        </li>
                        <li>
                            <a
                                href={`/${lang}/about`}
                                class="text-text-muted text-sm no-underline transition-colors hover:text-primary"
                                >{t("about", lang)}</a
                            >
                        </li>
                        <li>
                            <a
                                href={`/${lang}/blog`}
                                class="text-text-muted text-sm no-underline transition-colors hover:text-primary"
                                >{t("blog", lang)}</a
                            >
                        </li>
                        <li>
                            <a
                                href={`/${lang}/about-this-website`}
                                class="text-text-muted text-sm no-underline transition-colors hover:text-primary"
                                >{t("aboutThisWebsite", lang)}</a
                            >
                        </li>
                    </ul>
                </div>

                <div class="flex flex-col">
                    <h4
                        class="font-heading text-sm font-semibold text-text mb-4 uppercase tracking-wider"
                    >
                        Connect
                    </h4>
                    <ul class="flex flex-col gap-3">
                        {
                            socialLinks.map((link) => (
                                <li>
                                    <a
                                        href={link.href}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="text-text-muted text-sm no-underline transition-colors hover:text-primary"
                                    >
                                        {link.label}
                                    </a>
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </div>
        </div>

        <div class="pt-8 border-t border-border text-center">
            <p class="text-text-subtle text-sm">
                &copy; {currentYear} SEO Portfolio. All rights reserved.
            </p>
        </div>
    </div>
</footer>
