---
interface Props {
    lang?: "en" | "zh";
}

const { lang = "en" } = Astro.props;

const translations = {
    en: {
        title: "Get in Touch",
        subtitle:
            "Have a project in mind? Let's discuss how I can help grow your organic traffic.",
        name: "Your Name",
        email: "Your Email",
        message: "Your Message",
        send: "Send Message",
        sending: "Sending...",
        success: "Message sent successfully!",
        error: "Something went wrong. Please try again.",
    },
    zh: {
        title: "联系我",
        subtitle: "有项目想法？让我们讨论如何帮助您增加自然流量。",
        name: "您的姓名",
        email: "您的邮箱",
        message: "您的留言",
        send: "发送信息",
        sending: "发送中...",
        success: "消息发送成功！",
        error: "发送失败，请重试。",
    },
};

const t = translations[lang];
const RECAPTCHA_SITE_KEY = "6LeQYGMsAAAAAKVEO5JD3PLKai_LUGUJZv0eP2mo";
const WEB3FORMS_KEY = "6f64563a-9571-4fd9-b1ef-0bba06d5eb68";
---

<section class="py-24 relative overflow-hidden contact-section" id="contact">
    <div
        class="max-w-[1100px] mx-auto grid grid-cols-1 md:grid-cols-[1fr_1.2fr] gap-16 items-start relative z-10 px-8"
    >
        <div class="sticky top-8">
            <div class="p-8">
                <span
                    class="inline-block px-4 py-2 text-sm font-semibold text-primary bg-primary/10 rounded-full mb-6 uppercase tracking-wider"
                    >{lang === "zh" ? "联系方式" : "Contact Info"}</span
                >
                <h2
                    class="text-4xl md:text-5xl mb-4 font-bold bg-gradient-to-br from-primary to-indigo-400 bg-clip-text text-transparent leading-tight"
                >
                    {t.title}
                </h2>
                <p class="text-text-muted mb-10 text-lg leading-relaxed">
                    {t.subtitle}
                </p>

                <div class="flex flex-col gap-6 mb-10">
                    <div class="flex items-start gap-4 pl-2">
                        <div>
                            <span
                                class="text-sm text-text-muted uppercase tracking-wider block mb-1"
                                >{lang === "zh" ? "邮箱" : "Email"}</span
                            >
                            <a
                                href="mailto:ray00ooki@gmail.com"
                                class="text-text font-medium text-base hover:text-primary transition-colors"
                                >ray00ooki@gmail.com</a
                            >
                        </div>
                    </div>
                    <div class="flex items-start gap-4 pl-2">
                        <div>
                            <span
                                class="text-sm text-text-muted uppercase tracking-wider block mb-1"
                                >{lang === "zh" ? "地点" : "Location"}</span
                            >
                            <span class="text-text font-medium text-base"
                                >{lang === "zh" ? "马来西亚" : "Malaysia"}</span
                            >
                        </div>
                    </div>
                    <div class="flex items-start gap-4 pl-2">
                        <div>
                            <span
                                class="text-sm text-text-muted uppercase tracking-wider block mb-1"
                                >{
                                    lang === "zh" ? "响应时间" : "Response Time"
                                }</span
                            >
                            <span class="text-text font-medium text-base"
                                >{
                                    lang === "zh"
                                        ? "24小时内"
                                        : "Within 24 hours"
                                }</span
                            >
                        </div>
                    </div>
                </div>

                <div class="flex gap-4">
                    <a
                        href="#"
                        class="w-11 h-11 flex items-center justify-center bg-surface border border-border rounded-xl text-text-muted transition-all hover:bg-primary hover:text-white hover:-translate-y-1"
                        aria-label="LinkedIn"
                    >
                        <svg
                            width="20"
                            height="20"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
                            ></path></svg
                        >
                    </a>
                    <a
                        href="#"
                        class="w-11 h-11 flex items-center justify-center bg-surface border border-border rounded-xl text-text-muted transition-all hover:bg-primary hover:text-white hover:-translate-y-1"
                        aria-label="Twitter"
                    >
                        <svg
                            width="20"
                            height="20"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                            ></path></svg
                        >
                    </a>
                    <a
                        href="#"
                        class="w-11 h-11 flex items-center justify-center bg-surface border border-border rounded-xl text-text-muted transition-all hover:bg-primary hover:text-white hover:-translate-y-1"
                        aria-label="GitHub"
                    >
                        <svg
                            width="20"
                            height="20"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                            ></path></svg
                        >
                    </a>
                </div>
            </div>
        </div>

        <div
            class="bg-surface rounded-3xl p-8 md:p-10 border border-border shadow-2xl"
        >
            <form
                id="contact-form"
                action="https://api.web3forms.com/submit"
                method="POST"
                class="flex flex-col gap-6"
            >
                <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
                <input
                    type="hidden"
                    name="subject"
                    value="New Contact from SEO Portfolio"
                />
                <input
                    type="hidden"
                    name="from_name"
                    value="SEO Portfolio Contact"
                />
                <input
                    type="hidden"
                    name="redirect"
                    value={`https://seo-portfolio.ray00ooki.workers.dev/${lang}/?success=true`}
                />
                <input
                    type="checkbox"
                    name="botcheck"
                    class="hidden"
                    style="display: none;"
                />

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="flex flex-col gap-2">
                        <label for="name" class="font-medium text-text text-sm"
                            >{t.name}</label
                        >
                        <input
                            type="text"
                            id="name"
                            name="name"
                            required
                            placeholder={t.name}
                            class="w-full px-5 py-4 border-2 border-border rounded-xl bg-background text-text text-base transition-all placeholder:text-text-muted/60 focus:outline-none focus:border-primary focus:ring-4 focus:ring-primary/10"
                        />
                    </div>

                    <div class="flex flex-col gap-2">
                        <label for="email" class="font-medium text-text text-sm"
                            >{t.email}</label
                        >
                        <input
                            type="email"
                            id="email"
                            name="email"
                            required
                            placeholder={t.email}
                            class="w-full px-5 py-4 border-2 border-border rounded-xl bg-background text-text text-base transition-all placeholder:text-text-muted/60 focus:outline-none focus:border-primary focus:ring-4 focus:ring-primary/10"
                        />
                    </div>
                </div>

                <div class="flex flex-col gap-2">
                    <label for="message" class="font-medium text-text text-sm"
                        >{t.message}</label
                    >
                    <textarea
                        id="message"
                        name="message"
                        rows="6"
                        required
                        placeholder={t.message}
                        class="w-full px-5 py-4 border-2 border-border rounded-xl bg-background text-text text-base transition-all placeholder:text-text-muted/60 focus:outline-none focus:border-primary focus:ring-4 focus:ring-primary/10 resize-y min-h-[150px]"
                    ></textarea>
                </div>

                <button
                    type="submit"
                    class="submit-btn group flex items-center justify-center gap-3 w-full py-5 bg-gradient-to-br from-primary to-indigo-400 text-white border-0 rounded-xl text-lg font-semibold cursor-pointer transition-all hover:-translate-y-0.5 hover:shadow-lg disabled:opacity-70 disabled:cursor-not-allowed relative overflow-hidden"
                    id="submit-btn"
                >
                    <span class="btn-text">{t.send}</span>
                    <span class="btn-loading" style="display: none;"
                        >{t.sending}</span
                    >
                </button>

                <div
                    id="form-status"
                    class="hidden p-4 rounded-xl text-center font-medium mt-4"
                >
                </div>

                <p class="text-center text-sm text-text-muted mt-2">
                    {
                        lang === "zh"
                            ? "🔒 您的信息是安全的，我们不会分享给第三方。"
                            : "🔒 Your information is secure and will never be shared."
                    }
                </p>
            </form>
        </div>
    </div>
</section>

<!-- Form Script - Simple submission without reCAPTCHA requirement -->
<script is:inline>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.getElementById("contact-form");
        if (!form) return;

        form.addEventListener("submit", async function (e) {
            e.preventDefault();

            const submitBtn = document.getElementById("submit-btn");
            const btnText = submitBtn.querySelector(".btn-text");
            const btnLoading = submitBtn.querySelector(".btn-loading");
            const formStatus = document.getElementById("form-status");

            // Show loading state
            btnText.style.display = "none";
            btnLoading.style.display = "inline";
            submitBtn.disabled = true;
            formStatus.className =
                "hidden p-4 rounded-xl text-center font-medium mt-4";
            formStatus.textContent = "";

            try {
                const formData = new FormData(form);

                const response = await fetch(form.action, {
                    method: "POST",
                    body: formData,
                });

                const data = await response.json();
                console.log("Form response:", data);

                if (data.success) {
                    formStatus.textContent = "Message sent successfully! ✓";
                    formStatus.className =
                        "block p-4 rounded-xl text-center font-medium mt-4 bg-green-500/10 text-green-500 border border-green-500/30";
                    form.reset();
                } else {
                    formStatus.textContent =
                        data.message || "Submission failed. Please try again.";
                    formStatus.className =
                        "block p-4 rounded-xl text-center font-medium mt-4 bg-red-500/10 text-red-500 border border-red-500/30";
                }
            } catch (error) {
                console.error("Form error:", error);
                formStatus.textContent =
                    "Network error. Please check your connection.";
                formStatus.className =
                    "block p-4 rounded-xl text-center font-medium mt-4 bg-red-500/10 text-red-500 border border-red-500/30";
            } finally {
                btnText.style.display = "inline";
                btnLoading.style.display = "none";
                submitBtn.disabled = false;
            }
        });
    });
</script>

<style>
    .contact-section {
        background: linear-gradient(
            135deg,
            rgba(15, 15, 35, 0.95) 0%,
            rgba(30, 20, 60, 0.95) 50%,
            rgba(15, 15, 35, 0.95) 100%
        );
    }

    /* Background overlay with gradient mesh */
    .contact-section::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
            radial-gradient(
                ellipse at 20% 20%,
                rgba(99, 102, 241, 0.15) 0%,
                transparent 50%
            ),
            radial-gradient(
                ellipse at 80% 80%,
                rgba(139, 92, 246, 0.15) 0%,
                transparent 50%
            ),
            radial-gradient(
                ellipse at 50% 50%,
                rgba(79, 70, 229, 0.1) 0%,
                transparent 70%
            );
        z-index: 0;
    }

    /* Animated gradient orbs */
    .contact-section::after {
        content: "";
        position: absolute;
        top: 10%;
        left: 5%;
        width: 300px;
        height: 300px;
        background: radial-gradient(
            circle,
            rgba(99, 102, 241, 0.3) 0%,
            transparent 70%
        );
        border-radius: 50%;
        filter: blur(60px);
        animation: floatOrb 8s ease-in-out infinite;
        z-index: 0;
    }

    @keyframes floatOrb {
        0%,
        100% {
            transform: translate(0, 0) scale(1);
        }
        50% {
            transform: translate(30px, -30px) scale(1.1);
        }
    }

    /* Grid pattern overlay */
    .contact-section > div::after {
        content: "";
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
            linear-gradient(
                90deg,
                rgba(255, 255, 255, 0.02) 1px,
                transparent 1px
            );
        background-size: 50px 50px;
        z-index: 0;
        pointer-events: none;
    }

    :global(.grecaptcha-badge) {
        visibility: hidden;
    }
</style>
