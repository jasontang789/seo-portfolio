---
import type { SupportedLanguage } from "../lib/translate";
import { t } from "../lib/translate";

export interface Props {
    title: string;
    excerpt: string;
    slug: string;
    date: string;
    category?: string;
    image?: string;
    lang?: SupportedLanguage;
}

const {
    title,
    excerpt,
    slug,
    date,
    category,
    image,
    lang = "en",
} = Astro.props;

const locale = lang === "zh" ? "zh-CN" : "en-US";
const formattedDate = new Date(date).toLocaleDateString(locale, {
    year: "numeric",
    month: "long",
    day: "numeric",
});

const readMoreText = lang === "zh" ? "阅读更多 →" : "Read more →";
---

<article class="h-full">
    <a
        href={`/${lang}/blog/${slug}`}
        class="group block h-full bg-card-bg border border-border rounded-lg overflow-hidden card-hover"
    >
        {
            image && (
                <div class="aspect-video overflow-hidden bg-bg-secondary">
                    <img
                        src={image}
                        alt={title}
                        loading="lazy"
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    />
                </div>
            )
        }

        <div class="p-6">
            {
                category && (
                    <span class="inline-block px-3 py-1 text-xs font-medium text-primary bg-primary/10 rounded-full mb-3">
                        {category}
                    </span>
                )
            }

            <h3
                class="text-xl font-bold text-text leading-tight mb-3 font-heading"
            >
                {title}
            </h3>

            <p
                class="text-text-muted text-sm leading-relaxed mb-4 line-clamp-3"
            >
                {excerpt}
            </p>

            <div
                class="flex items-center justify-between pt-4 border-t border-border/50"
            >
                <time datetime={date} class="text-xs text-text-muted/80"
                    >{formattedDate}</time
                >
                <span
                    class="text-sm font-medium text-primary transition-colors group-hover:text-primary-dark"
                    >{readMoreText}</span
                >
            </div>
        </div>
    </a>
</article>
