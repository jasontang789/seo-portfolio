---
// Header Component with Glassmorphism Effect
// Sticky navigation with theme toggle and language switcher

import { t, type SupportedLanguage } from "../lib/translate";

interface Props {
    lang?: SupportedLanguage;
}

const { lang = "en" } = Astro.props;

const navItems = [
    { key: "home", href: `/${lang}` },
    { key: "about", href: `/${lang}/about` },
    { key: "blog", href: `/${lang}/blog` },
    { key: "aboutThisWebsite", href: `/${lang}/about-this-website` },
];

const currentPath = Astro.url.pathname;
const otherLang = lang === "en" ? "zh" : "en";
const switchLangUrl = currentPath.replace(`/${lang}`, `/${otherLang}`);
---

<header class="sticky top-0 z-50 glass transition-all border-b border-white/5">
    <nav class="container flex items-center justify-between h-20">
        <a
            href={`/${lang}`}
            class="font-heading text-xl font-bold text-text no-underline"
        >
            <span class="text-text"
                >SEO<span class="text-primary">Pro</span></span
            >
        </a>

        <ul
            id="nav-menu"
            class="fixed top-[72px] left-0 right-0 flex flex-col gap-0 bg-background/95 backdrop-blur-xl border-b border-white/10 p-4 translate-y-[-150%] opacity-0 invisible transition-all duration-300 md:translate-y-0 md:opacity-100 md:visible md:static md:flex-row md:bg-transparent md:border-none md:p-0 md:gap-8 data-[open=true]:translate-y-0 data-[open=true]:opacity-100 data-[open=true]:visible"
        >
            {
                navItems.map((item) => (
                    <li class="w-full md:w-auto">
                        <a
                            href={item.href}
                            class:list={[
                                "relative block py-4 text-center md:py-2 md:text-left text-sm font-medium text-text-muted hover:text-text transition-colors group",
                                {
                                    "text-text":
                                        currentPath === item.href ||
                                        (item.href !== `/${lang}` &&
                                            currentPath.startsWith(item.href)),
                                },
                            ]}
                        >
                            {t(item.key, lang)}
                            <span
                                class:list={[
                                    "absolute bottom-0 left-0 h-0.5 bg-primary transition-all duration-300",
                                    currentPath === item.href ||
                                    (item.href !== `/${lang}` &&
                                        currentPath.startsWith(item.href))
                                        ? "w-full"
                                        : "w-0 group-hover:w-full",
                                ]}
                            />
                        </a>
                    </li>
                ))
            }
        </ul>

        <div class="flex items-center gap-3">
            <!-- Language Toggle -->
            <a
                href={switchLangUrl}
                class="flex items-center justify-center px-3 py-2 text-sm font-medium text-text bg-transparent border border-border rounded-lg transition-all hover:bg-white/5 hover:border-primary hover:text-primary"
                aria-label="Switch language"
            >
                {lang === "en" ? "中文" : "EN"}
            </a>

            <button
                class="flex items-center justify-center w-10 h-10 bg-transparent border border-border rounded-lg text-text cursor-pointer transition-all hover:bg-white/5 hover:border-primary"
                onclick="toggleTheme()"
                aria-label="Toggle theme"
            >
                <!-- Sun Icon (for light mode) -->
                <svg
                    class="hidden [html[data-theme='light']_&]:block w-5 h-5"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <circle cx="12" cy="12" r="5"></circle>
                    <line x1="12" y1="1" x2="12" y2="3"></line>
                    <line x1="12" y1="21" x2="12" y2="23"></line>
                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                    <line x1="1" y1="12" x2="3" y2="12"></line>
                    <line x1="21" y1="12" x2="23" y2="12"></line>
                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                </svg>
                <!-- Moon Icon (for dark mode) -->
                <svg
                    class="block [html[data-theme='light']_&]:hidden w-5 h-5"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
                    ></path>
                </svg>
            </button>

            <button
                id="mobile-menu-btn"
                class="md:hidden flex flex-col justify-center gap-1.5 w-10 h-10 bg-transparent border border-border rounded-lg cursor-pointer p-2"
                aria-label="Toggle menu"
            >
                <span class="w-full h-0.5 bg-text block transition-all"></span>
                <span class="w-full h-0.5 bg-text block transition-all"></span>
                <span class="w-full h-0.5 bg-text block transition-all"></span>
            </button>
        </div>
    </nav>
</header>

<script>
    // Mobile menu toggle
    const mobileMenuBtn = document.getElementById("mobile-menu-btn");
    const navMenu = document.getElementById("nav-menu");

    mobileMenuBtn?.addEventListener("click", () => {
        const isOpen = navMenu?.getAttribute("data-open") === "true";
        navMenu?.setAttribute("data-open", String(!isOpen));

        // rudimentary hamburger animation if needed, but keeping it simple for now
    });
</script>
